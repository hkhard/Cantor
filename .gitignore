target/
.DS_Store
node_modules/

# Private sample files from the product owner (copyrighted scores), never commit.
# Anchored to the repo root: fixtures/scores/ holds the public test scores.
/scores/

# Python venvs for tools
tools/**/.venv/

# Tauri app build output and bundled private scores
app/src-tauri/target/
app/src-tauri/gen/schemas/
app/src-tauri/resources/scores/
app/ui/dist/
# Copied into the iOS project on every build (contains the private scores)
app/src-tauri/gen/apple/assets/
# Same for Android (Tauri copies the resources into the APK assets)
app/src-tauri/gen/android/app/src/main/assets/
target-wt/
target-android/

# homr ONNX models (AGPL, 129 MB): tools/omr/homr_port/fetch_models.sh
/models/
# LIB-10: ONNX Runtime for iOS (tools/omr/homr_port/fetch_ort_ios.sh) and
# the models copied into the app (tools/bundle_homr_models.sh).
/vendor/
app/src-tauri/resources/homr/

# App Store screenshots and upload package (tools/store/make_screenshots.sh)
/store-out/

# The Anchor Song: private test fixture (the song is Björk's). Kept locally, never on GitHub.
/fixtures/scores/the-anchor-song/
