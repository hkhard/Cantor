{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChoirBird",
  "version": "0.1.0",
  "identifier": "se.nikielhard.choirbird",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "ChoirBird",
        "width": 1366,
        "height": 1024,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/scores/": "resources/scores/",
      "../../assets/sf2/GeneralUser-GS.sf2": "resources/GeneralUser-GS.sf2"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "33ZQ6Q226L",
      "minimumSystemVersion": "16.0"
    }
  }
}
